    },
    {
      "external_id": "valheim-main",
      "game": "valheim",
      "name": "WWG Valheim",
      "template": "world",
      "join_address": "valheim.example.co.ke:2456",
      "source": {"type": "a2s", "host": "127.0.0.1", "port": 2457}
    },
    {
      "external_id": "pal-1",
      "game": "palworld",
